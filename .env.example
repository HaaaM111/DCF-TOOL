# Copy to .env.local. Never commit real credentials. Node.js >=22 required.
DATABASE_URL=file:./prisma/user.db
BASELINE_DATABASE_URL=file:./prisma/base.db
# Single-user login (admin). Both variables are required.
APP_ACCESS_PASSWORD=
# Generate an independent secret with: node -e "console.log(require('node:crypto').randomBytes(32).toString('hex'))"
APP_SESSION_SECRET=
LLM_API_KEY=
LLM_BASE_URL=https://maas-api.cn-huabei-1.xf-yun.com/v2/chat/completions
LLM_MODEL_NAME=spark-x2.6-4b
LLM_THINKING=disabled
LLM_TIMEOUT_MS=30000
AGENT_MAX_STEPS=5
# Additional operator-approved HTTPS hostnames, comma separated, no wildcards.
LLM_ALLOWED_HOSTS=
DOCUMENT_ALLOWED_HOSTS=static.cninfo.com.cn
# Optional: a confirmed image/PDF-capable model on the configured provider.
VISION_MODEL_NAME=
IFIND_REFRESH_TOKEN=
CORS_ORIGIN=http://localhost:3000
