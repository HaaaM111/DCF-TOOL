# ===== ValueInsight 生产环境配置 =====
# 复制此文件为 .env 并填入真实值，切勿提交到 Git

# ===== 数据库 =====
# 用户库：假设/报告/时间线等用户使用数据（相对路径，兼容任意部署位置）
DATABASE_URL="file:./prisma/user.db"
# 基准库：公司档案（只读，维护走 scripts/manage-baseline.ts）
BASELINE_DATABASE_URL="file:./prisma/baseline.db?mode=ro"
# 如需使用 PostgreSQL，改为：
# DATABASE_URL="postgresql://user:password@localhost:5432/valueinsight?schema=public"

# ===== 安全配置 =====
# 【上线必改】改为你的真实域名（如 https://your-domain.com），逗号分隔多个
# 留占位符不影响本机使用，但跨域访问会被浏览器拦截
CORS_ORIGIN="https://your-domain.com"
# IP 限流（次/分钟/IP；nginx 已设置 X-Real-IP，无法被伪造绕过）
RATE_LIMIT_PER_MINUTE="120"
MAX_IMPORT_BYTES="5242880"
VERIFY_CALCULATION="true"

# ===== 同花顺 iFinD API =====
# 填入你的 refresh_token，留空则进入 mock 模式
IFIND_REFRESH_TOKEN=""
IFIND_BASE_URL="https://quantapi.51ifind.com"
IFIND_TOKEN_PATH="/api/v1/get_access_token"

# ===== DeepSeek AI 归因 =====
# 填入你的 DeepSeek API Key，留空则 AI 归因功能不可用
DEEPSEEK_API_KEY=""
DEEPSEEK_BASE_URL="https://api.deepseek.com"

# ===== 服务端口 =====
PORT=3000
# 只监听本机回环：由 nginx 反代转发，公网无法直连 3000 端口
HOSTNAME="127.0.0.1"
